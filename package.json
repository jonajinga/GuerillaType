{
  "name": "guerillatype",
  "version": "0.1.0",
  "description": "A free, open-source, adaptive typing tutor. localStorage only, no accounts.",
  "homepage": "https://guerillatype.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonajinga/GuerillaType.git"
  },
  "bugs": {
    "url": "https://github.com/jonajinga/GuerillaType/issues"
  },
  "author": "Jon Ajinga",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "eleventy --serve",
    "dev": "eleventy --serve",
    "build": "eleventy && node scripts/version-js-imports.mjs",
    "clean": "npx rimraf _site",
    "audit": "node scripts/audit-viewports.mjs",
    "stats": "node scripts/fetch-umami-stats.mjs",
    "polish-books": "node scripts/polish-books.mjs",
    "postbuild": "node scripts/version-js-imports.mjs",
    "version-imports": "node scripts/version-js-imports.mjs",
    "custom-segments": "node scripts/check-custom-segments.mjs",
    "custom-large": "node scripts/check-custom-large-import.mjs",
    "custom-branches": "node scripts/check-custom-storage-branches.mjs",
    "custom-sample": "node scripts/check-custom-sample.mjs",
    "prebuild": "node scripts/build-custom-sample.mjs",
    "custom-sample-data": "node scripts/build-custom-sample.mjs",
    "book-chapters": "node scripts/check-book-chapters.mjs",
    "nav-scroll": "node scripts/check-nav-scroll.mjs",
    "typing-perf": "node scripts/check-typing-perf.mjs",
    "caret-follow": "node scripts/check-caret-follow.mjs",
    "idioms": "node scripts/check-idioms.mjs",
    "poetry": "node scripts/check-poetry.mjs",
    "quotes": "node scripts/check-quotes.mjs",
    "parables": "node scripts/check-parables.mjs",
    "caret-proportional": "node scripts/check-caret-proportional.mjs",
    "import-whitespace": "node scripts/check-import-whitespace.mjs",
    "import-extraction": "node scripts/check-import-extraction.mjs",
    "theme-persistence": "node scripts/check-theme-persistence.mjs",
    "lesson-resume": "node scripts/check-lesson-resume.mjs",
    "lesson-trends": "node scripts/check-lesson-trends.mjs",
    "adaptive-drills": "node scripts/check-adaptive-drills.mjs",
    "custom-lesson-progress": "node scripts/check-custom-lesson-progress.mjs",
    "game-powerups": "node scripts/check-game-powerups.mjs",
    "punctuation-storm": "node scripts/check-punctuation-storm.mjs",
    "custom-header": "node scripts/check-custom-header.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-rss": "^2.0.2",
    "@sardine/eleventy-plugin-tinyhtml": "^0.2.0",
    "luxon": "^3.4.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "lightningcss": "^1.32.0",
    "playwright": "^1.59.1",
    "rimraf": "^5.0.5"
  }
}
