/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), geolocation=(), microphone=(), camera=()
  X-Frame-Options: DENY

# JS modules: short cache + must-revalidate. Static ES imports inside
# practice-boot.js (renderer.js, typing-engine.js, etc.) don't carry
# the ?v=cssVersion query bust we put on the top-level dynamic import.
# A 1-year immutable cache here freezes those files at the Cloudflare
# edge for a year, defeating every site update. 5-minute cache lets
# the CDN coalesce traffic spikes but new builds reach users within
# minutes, not next year.
/assets/js/*
  Cache-Control: public, max-age=300, must-revalidate

# CSS: same -- the ?v= on the <link> changes the URL each build, but
# guard against future static @imports going stale.
/assets/css/*
  Cache-Control: public, max-age=300, must-revalidate

# Fonts + images: rarely change, keep the long cache.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Share cards. Built fresh on every deploy into _site/og/**, so they
# cannot be immutable -- a card's URL never changes but its contents do
# when the corpus or the card design does. A day is long enough for the
# scrapers (X, Facebook, Slack) that fetch an image once per link.
/og/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=86400

# Shared results. A /r/ link is one person's run, not a page of this
# site: it must never turn up in a search result. Note that _headers
# rules do NOT apply to Pages Function responses, and /r/ is served by
# functions/r/index.js, which sets the same two headers itself. This
# block covers the static asset behind it (which the Function fetches
# through env.ASSETS) and anything that reaches /r/ without the
# Function -- a preview built before the Function deployed, say.
/r/*
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=300

/*.html
  Cache-Control: public, max-age=300, must-revalidate
