---
layout: layouts/base.njk
---
<div class="post-page">
  <div class="post-progress" id="post-progress" aria-hidden="true"></div>

  <article class="post" id="post-body">
    <header class="post__head">
      <a class="tt-back-link" href="/blog/">← All posts</a>
      <p class="post__eyebrow">{% if eyebrow %}{{ eyebrow }}{% else %}Notes{% endif %}</p>
      <h1 class="post__title">{{ title }}</h1>
      <p class="post__deck">{{ description }}</p>
      <div class="post__meta">
        <span class="post__readtime">{{ content | striptags | readingTime }} min read</span>
        {% if tags %}
        <span class="post__meta-dot" aria-hidden="true">·</span>
        <span class="post__tags">
          {%- for t in tags -%}{%- if t != "post" -%}<a class="post__tag" href="/blog/tag/{{ t | slugify }}/">{{ t }}</a>{%- endif -%}{%- endfor -%}
        </span>
        {% endif %}
      </div>
    </header>

    <div class="post__layout">
      <aside class="post__toc" aria-label="On this page">
        <p class="post__toc-title">On this page</p>
        <nav class="post__toc-list" id="post-toc"></nav>

        {#- The share row routes through assets/js/share/share.js: the
            four icons keep their look but their hrefs, their analytics
            and the "More" sheet all come from one module now, so a new
            destination is added in one place. The payload lives on the
            row; share.js reads it from the nearest ancestor that
            carries it. -#}
        <div class="post__share" data-share-row
             data-share-kind="post"
             data-share-surface="post"
             data-share-title="{{ title }}"
             data-share-text="{{ title }}"
             data-share-url="{{ site.url }}{{ page.url }}"
             data-share-image="{{ site.url }}{{ ogImage or site.ogImage }}">
          <p class="post__share-title">Share</p>
          <div class="post__share-row">
            <a class="post__share-link" data-share-intent="x" id="share-x" aria-label="Share on X" data-tip="Share on X">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4l16 16M20 4L4 20"/>
              </svg>
            </a>
            <a class="post__share-link" data-share-intent="linkedin" id="share-li" aria-label="Share on LinkedIn" data-tip="Share on LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="8" y1="11" x2="8" y2="17"/>
                <circle cx="8" cy="7.5" r="1" fill="currentColor" stroke="none"/>
                <path d="M12 17v-4a2 2 0 0 1 4 0v4"/>
                <line x1="12" y1="11" x2="12" y2="17"/>
              </svg>
            </a>
            <a class="post__share-link" data-share-intent="email" id="share-email" aria-label="Share by email" data-tip="Share by email">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="M3 7l9 7 9-7"/>
              </svg>
            </a>
            <button type="button" class="post__share-link" data-share-intent="copy" id="share-copy" aria-label="Copy link" data-tip="Copy link">
              {# Chain-link icon redrawn with the same stroke weight + style
                 vocabulary as the X/LinkedIn/email icons next to it. The
                 previous Feather-style chain looked thicker because its
                 arcs rendered as overlapping curves at 18px. This version
                 uses two simple straight-link rectangles plus a connecting
                 line -- visually consistent with the rest of the row. #}
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="9" width="9" height="6" rx="3"/>
                <rect x="13" y="9" width="9" height="6" rx="3"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
              </svg>
            </button>
            <button type="button" class="post__share-link" data-share id="share-more" aria-label="More ways to share" data-tip="More ways to share">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="5" cy="12" r="1.4"/>
                <circle cx="12" cy="12" r="1.4"/>
                <circle cx="19" cy="12" r="1.4"/>
              </svg>
            </button>
          </div>
        </div>
      </aside>

      <div class="post__body">
        {{ content | safe }}
      </div>
    </div>

    <footer class="post__foot">
      <div class="post__author">
        <a class="post__author-photo" href="https://jonajinga.com" target="_blank" rel="noopener" aria-label="Jon Ajinga's site">
          {% image "src/assets/img/jon-ajinga.webp", "Jon Ajinga", 160 %}
        </a>
        <div class="post__author-text">
          <p class="post__author-name"><a href="https://jonajinga.com" target="_blank" rel="noopener">{{ author or "Jon Ajinga" }}</a></p>
          <p class="post__author-bio">I built GuerillaType. I'd be happy to hear from you -- I read every message.</p>
        </div>
        <a class="btn" href="/contribute/">Contribute to GT →</a>
      </div>

      {% set posts = collections.post | reverse %}
      {% set ix = 0 %}
      {% for p in posts %}{% if p.url == page.url %}{% set ix = loop.index0 %}{% endif %}{% endfor %}
      <nav class="post__neighbors" aria-label="Adjacent posts">
        {% if ix > 0 %}
          {% set prev = posts[ix - 1] %}
          <a class="post__neighbor post__neighbor--prev" href="{{ prev.url }}">
            <span class="post__neighbor-eyebrow">← Newer</span>
            <span class="post__neighbor-title">{{ prev.data.title }}</span>
          </a>
        {% else %}
          <span></span>
        {% endif %}
        {% if ix + 1 < posts.length %}
          {% set next = posts[ix + 1] %}
          <a class="post__neighbor post__neighbor--next" href="{{ next.url }}">
            <span class="post__neighbor-eyebrow">Older →</span>
            <span class="post__neighbor-title">{{ next.data.title }}</span>
          </a>
        {% endif %}
      </nav>
    </footer>
  </article>
</div>

<script type="module">
  /* Reading-progress bar: scrolls 0→100% as the user reads through
     the article body. Plus auto-TOC build from h2/h3 inside .post__body. */
  const body = document.getElementById("post-body");
  const bar = document.getElementById("post-progress");
  function progress() {
    const r = body.getBoundingClientRect();
    const h = body.scrollHeight - window.innerHeight;
    const passed = Math.max(0, Math.min(1, (-r.top) / (h || 1)));
    bar.style.width = (passed * 100).toFixed(1) + "%";
  }
  document.addEventListener("scroll", progress, { passive: true });
  progress();

  // Auto-TOC
  const toc = document.getElementById("post-toc");
  const headings = body.querySelectorAll(".post__body h2, .post__body h3");
  if (headings.length && toc) {
    const items = [];
    headings.forEach((h, i) => {
      if (!h.id) h.id = h.textContent.toLowerCase().replace(/[^\w\s-]/g, "").trim().replace(/\s+/g, "-") || `h-${i}`;
      const a = document.createElement("a");
      a.href = "#" + h.id;
      a.textContent = h.textContent;
      a.className = h.tagName === "H3" ? "post__toc-link post__toc-link--sub" : "post__toc-link";
      toc.appendChild(a);
      items.push({ a, h });
    });
    // Highlight active section while scrolling.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        items.forEach(({ a, h }) => a.classList.toggle("is-active", h === e.target));
      });
    }, { rootMargin: "-30% 0px -60% 0px", threshold: 0 });
    items.forEach(({ h }) => io.observe(h));
  }

  /* The share row is wired by assets/js/share/share.js, which
     main.js calls on every page. Nothing to do here. */
</script>
