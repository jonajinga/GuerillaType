<!doctype html>
<html lang="{{ site.language }}" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="{{ site.themeColor }}">
<meta name="color-scheme" content="dark light">
<title>{{ title }}{% if title %} | {% endif %}{{ site.shortTitle }}</title>
<meta name="description" content="{{ description or site.description }}">
{%- if noindex %}
{# `noindex: true` in a page's front matter already keeps it out of
   sitemap.xml. This makes it mean the whole thing: crawlers are told
   as well. Used by /r/, a shared result -- one person's run, not a
   page of this site. #}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
{% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% else %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}

{# Open Graph / Twitter. og:image MUST be a raster format: X, Facebook,
   LinkedIn, Slack and iMessage all silently drop an SVG, which is why
   every share preview of this site was blank until 2026-09-16. The
   default card is generated by scripts/gen-og-default.mjs and committed
   as a PNG. Absolute URLs everywhere -- scrapers do not resolve
   relative ones. Per-page front matter may override ogImage,
   ogImageWidth, ogImageHeight, ogImageAlt and ogType. #}
{%- set ogImg = ogImage or site.ogImage -%}
{%- set ogMime = "image/png" -%}
{%- if ".jpg" in ogImg or ".jpeg" in ogImg -%}{%- set ogMime = "image/jpeg" -%}
{%- elif ".svg" in ogImg -%}{%- set ogMime = "image/svg+xml" -%}
{%- elif ".webp" in ogImg -%}{%- set ogMime = "image/webp" -%}{%- endif -%}
{%- set ogAlt = ogImageAlt or site.ogImageAlt or (title or site.title) -%}
<meta property="og:type" content="{{ ogType or "website" }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:image" content="{{ site.url }}{{ ogImg }}">
<meta property="og:image:type" content="{{ ogMime }}">
<meta property="og:image:width" content="{{ ogImageWidth or site.ogImageWidth }}">
<meta property="og:image:height" content="{{ ogImageHeight or site.ogImageHeight }}">
<meta property="og:image:alt" content="{{ ogAlt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImg }}">
<meta name="twitter:image:alt" content="{{ ogAlt }}">

{# Favicon: red recolor of the full brand image (gorilla figure
   on a cream tile). Single icon -- no theme branching -- so the
   browser tab + bookmark always show the same recognizable red
   mark. ?v={{ cssVersion }} forces browsers + Cloudflare to
   refetch when the file contents change. #}
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-red-32.png?v={{ cssVersion }}">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-red-16.png?v={{ cssVersion }}">
<link rel="icon" type="image/png" sizes="48x48" href="/assets/img/favicon-red-48.png?v={{ cssVersion }}">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/apple-touch-icon-red.png?v={{ cssVersion }}">
<link rel="manifest" href="/site.webmanifest">

{# No-flash theme — runs synchronously before paint. #}
<script>
(function(){try{
var saved = localStorage.getItem("tt:theme");
var sys = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
var t = saved && saved !== "system" ? saved : sys;
document.documentElement.setAttribute("data-theme", t);
}catch(e){}})();
</script>

{# Bunny Fonts — privacy-friendly, no cookies. Every typing font in
   the Settings picker is served from here EXCEPT Iosevka, which
   Bunny does not carry (its API answers "Please specify a valid icon
   font on the 'family' parameter" for family=iosevka). Iosevka is
   therefore the one self-hosted family — see css/partials/fonts.css
   and assets/fonts/README.md. Everything else, Cascadia Code
   included, comes from Bunny. #}
<link rel="preconnect" href="https://fonts.bunny.net" crossorigin>
<link rel="stylesheet" href="https://fonts.bunny.net/css?family=lora:400,500,600,700|inter:400,500,600,700|jetbrains-mono:400,500|fira-code:400,500|ibm-plex-mono:400,500|cascadia-code:400|roboto-mono:400,500|source-code-pro:400,500|ubuntu-mono:400|space-mono:400,700|inconsolata:400,500,700|cousine:400,700&display=swap">

<link rel="stylesheet" href="/assets/css/global.css?v={{ cssVersion }}">

{# JSON-LD: site-wide WebSite + Organization + SoftwareApplication +
   per-page WebPage, BreadcrumbList, Book or BlogPosting as relevant.
   See partials/head/jsonld.njk for the @graph composition. #}
{% include "partials/head/jsonld.njk" %}

{# Analytics. A page can switch third-party analytics off entirely with
   `noThirdPartyScripts: true`, and /r/ does. (`noAnalytics` is still
   honoured; it was the narrower first version of the same flag.)

   Measured on 2026-09-16, not assumed: umami's tracker reports
   `location.href` verbatim in every payload it sends, fragment
   included. On /r/ the fragment is what somebody typed and the
   keystroke record of how they typed it, so loading umami there would
   POST both to gateway.umami.is on page load. The script does support
   `data-exclude-hash`, but the fix for this page should not depend on
   a third party keeping an attribute. #}
{% if not noAnalytics and not noThirdPartyScripts %}
{% include "partials/analytics/umami.njk" %}
{% include "partials/analytics/cf-web-analytics.njk" %}
{% endif %}
</head>
<body data-page="{{ pageSlug or page.fileSlug or 'page' }}"{% if noThirdPartyScripts %} data-no-third-party="true"{% endif %}>
<script>
/* Mark the body as embedded when the URL has ?embed=1 so iframe
   hosts (settings modal) can hide site chrome via CSS. Inline +
   synchronous so there is no flash of header/footer before paint. */
(function(){try{
if (location.search.indexOf("embed=1") !== -1) document.body.classList.add("is-embedded");
}catch(e){}})();
</script>

<a class="skip-link" href="#main">Skip to content</a>

{% include "partials/nav/header.njk" %}
{% include "partials/nav/hamburger-panel.njk" %}

{% include "partials/nav/breadcrumbs.njk" %}
<main id="main" class="site-main">
  {{ content | safe }}
</main>

{% include "partials/footer/site-footer.njk" %}

<button type="button" id="back-to-top" class="back-to-top" aria-label="Back to top" hidden onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

<script>window.__cssVersion="{{ cssVersion }}";</script>
<script type="module" src="/assets/js/main.js?v={{ cssVersion }}"></script>
<script type="module" src="/assets/js/tooltips.js?v={{ cssVersion }}"></script>
<script type="module" src="/assets/js/brand-flair.js?v={{ cssVersion }}"></script>

{# instant.page -- preloads internal links on hover/touchstart so
   in-site navigation feels instant. ~1 KB, no config required.
   Skip prefetching the practice surface so we never preload its
   heavy bundle on a casual hover.

   Not on /r/. A third-party script runs in this document, and this
   document's address carries what somebody typed after the "#". It
   does not matter that instant.page has no reason to read it; the
   promise on that page is that nothing which can read the fragment is
   loaded from anywhere but here, and a promise with an exception in it
   is not one. The Bunny Fonts stylesheet stays: a stylesheet cannot
   read a fragment, and a Referer header never carries one. #}
{% if not noThirdPartyScripts %}
<link rel="preconnect" href="https://instant.page" crossorigin>
<script src="//instant.page/5.2.0" type="module" integrity="sha384-jnZyxPjiipYXnSU0ygqeac2q7CVYMbh84q0uHVRRxEtvFPiQYbXWUorga2aqZJ0z"></script>
{% endif %}
</body>
</html>
