{# Best-in-class slide-in nav panel.
   Layout (top to bottom):
     1. Brand header   -- icon + wordmark + close button
     2. Quick row      -- 4 large iconographic CTAs (start typing, today's
                          quote, stats, settings)
     3. Search filter  -- live filter for the link list below; matches
                          label OR description in any section
     4. Stats card     -- streak / sessions / best WPM glance, populated
                          from the active profile by panel.js
     5. Sections       -- one <details> per megamenu category, each item
                          rendered as a 2-line link (label + description)
                          for scannable density
     6. Project + Site -- standalone meta sections
     7. Theme toggle   -- quick switch without leaving the panel
     8. Social footer  -- GitHub, RSS, Email, Contact
   Every section is collapsed by default; the user expands what they
   want. Sections auto-expand if the search filter has a hit inside.
#}
<aside id="hamburger-panel" class="nav-panel" aria-hidden="true" tabindex="-1" role="dialog" aria-label="Site navigation">
  <header class="nav-panel__head">
    <a class="nav-panel__brand" href="/" aria-label="{{ site.title }} home">
      <img class="nav-panel__brand-mark" src="/assets/img/icon-192.png" alt="" width="32" height="32" decoding="async" data-brand-mark>
      <span class="nav-panel__brand-name">Guerilla<em>Type</em></span>
    </a>
    <button type="button" class="nav-panel__close" aria-label="Close menu"
            onclick="window.closeNavPanel && window.closeNavPanel()">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 6 18 18M18 6 6 18"/>
      </svg>
    </button>
  </header>

  <div class="nav-panel__quick" role="group" aria-label="Quick start">
    <a class="nav-panel__quick-btn" href="/practice/?mode=time&duration=30">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M9 1h6"/></svg>
      <span>30s test</span>
    </a>
    <a class="nav-panel__quick-btn" href="/practice/?mode=quote&quote=daily">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H8l-5 1Z"/><path d="M8 10h8M8 14h6"/></svg>
      <span>Daily quote</span>
    </a>
    <a class="nav-panel__quick-btn" href="/stats/">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-7"/></svg>
      <span>Stats</span>
    </a>
    <a class="nav-panel__quick-btn" href="/settings/" onclick="if(window.openSettingsModal){return window.openSettingsModal(event)}">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
      <span>Settings</span>
    </a>
  </div>

  <div class="nav-panel__search-wrap">
    <input type="search" class="nav-panel__search" id="nav-panel-search"
           placeholder="Filter the menu…" aria-label="Filter menu items"
           autocomplete="off" autocapitalize="off" spellcheck="false">
  </div>

  <div class="nav-panel__profile-card" id="nav-panel-profile" hidden>
    <div class="nav-panel__profile-row">
      <div class="nav-panel__profile-stat">
        <span class="nav-panel__profile-num" data-pf="streak">0</span>
        <span class="nav-panel__profile-lbl">day streak</span>
      </div>
      <div class="nav-panel__profile-stat">
        <span class="nav-panel__profile-num" data-pf="sessions">0</span>
        <span class="nav-panel__profile-lbl">sessions</span>
      </div>
      <div class="nav-panel__profile-stat">
        <span class="nav-panel__profile-num" data-pf="bestWpm">0</span>
        <span class="nav-panel__profile-lbl">best wpm</span>
      </div>
    </div>
    <a class="nav-panel__profile-link" href="/stats/">View full stats →</a>
  </div>

  <nav class="nav-panel__nav" aria-label="Site sections">
    {% for item in megamenu %}
    <details class="nav-panel__group" data-group="{{ item.label | slugify }}">
      <summary class="nav-panel__group-summary">
        <span class="nav-panel__group-label">{{ item.label }}</span>
        <span class="nav-panel__group-count" data-count></span>
        <span class="nav-panel__chev" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </span>
      </summary>
      <ul class="nav-panel__list">
        {% set seenInGroup = [] %}
        {% for group in item.groups %}{% for sub in group.items %}
        {%- if seenInGroup.indexOf(sub.url) === -1 -%}
        <li class="nav-panel__item" data-haystack="{{ sub.label | lower }} {{ sub.desc | lower }}">
          <a href="{{ sub.url }}" {% if page.url == sub.url %}aria-current="page"{% endif %}>
            <span class="nav-panel__item-label">{{ sub.label }}</span>
            {% if sub.desc %}<span class="nav-panel__item-desc">{{ sub.desc }}</span>{% endif %}
          </a>
        </li>
        {%- set _ = seenInGroup.push(sub.url) -%}
        {%- endif -%}
        {% endfor %}{% endfor %}
      </ul>
    </details>
    {% endfor %}

    <details class="nav-panel__group" data-group="project">
      <summary class="nav-panel__group-summary">
        <span class="nav-panel__group-label">Project</span>
        <span class="nav-panel__group-count" data-count></span>
        <span class="nav-panel__chev" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </span>
      </summary>
      <ul class="nav-panel__list">
        <li class="nav-panel__item" data-haystack="about why this exists"><a href="/about/"><span class="nav-panel__item-label">About</span><span class="nav-panel__item-desc">Why this site exists.</span></a></li>
        <li class="nav-panel__item" data-haystack="features full list capabilities"><a href="/features/"><span class="nav-panel__item-label">Features</span><span class="nav-panel__item-desc">Full list of what the site can do.</span></a></li>
        <li class="nav-panel__item" data-haystack="changelog updates additions"><a href="/changelog/"><span class="nav-panel__item-label">Changelog</span><span class="nav-panel__item-desc">Recent additions and fixes.</span></a></li>
        <li class="nav-panel__item" data-haystack="blog posts notes"><a href="/blog/"><span class="nav-panel__item-label">Blog</span><span class="nav-panel__item-desc">Notes from the maker.</span></a></li>
        <li class="nav-panel__item" data-haystack="faq questions"><a href="/faq/"><span class="nav-panel__item-label">FAQ</span><span class="nav-panel__item-desc">Common questions, answered.</span></a></li>
        <li class="nav-panel__item" data-haystack="contact email feedback"><a href="/contact/"><span class="nav-panel__item-label">Contact</span><span class="nav-panel__item-desc">Bug, feature, or hello.</span></a></li>
        <li class="nav-panel__item" data-haystack="cost run hosting"><a href="/cost/"><span class="nav-panel__item-label">Cost to run</span><span class="nav-panel__item-desc">How the site stays free.</span></a></li>
        <li class="nav-panel__item" data-haystack="analytics tracking privacy"><a href="/analytics/"><span class="nav-panel__item-label">Analytics</span><span class="nav-panel__item-desc">What's tracked, what isn't.</span></a></li>
        <li class="nav-panel__item" data-haystack="tech stack technology"><a href="/tech-stack/"><span class="nav-panel__item-label">Tech stack</span><span class="nav-panel__item-desc">What this is built with.</span></a></li>
        <li class="nav-panel__item" data-haystack="style guide design tokens"><a href="/style-guide/"><span class="nav-panel__item-label">Style guide</span><span class="nav-panel__item-desc">Design tokens + components.</span></a></li>
      </ul>
    </details>

    <details class="nav-panel__group" data-group="site">
      <summary class="nav-panel__group-summary">
        <span class="nav-panel__group-label">Site</span>
        <span class="nav-panel__group-count" data-count></span>
        <span class="nav-panel__chev" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </span>
      </summary>
      <ul class="nav-panel__list">
        <li class="nav-panel__item" data-haystack="search find ctrl k"><a href="/search/"><span class="nav-panel__item-label">Search</span><span class="nav-panel__item-desc">Find any page on the site.</span></a></li>
        <li class="nav-panel__item" data-haystack="sitemap full index pages"><a href="/sitemap/"><span class="nav-panel__item-label">Site index</span><span class="nav-panel__item-desc">Every page in one list.</span></a></li>
        <li class="nav-panel__item" data-haystack="rss feed subscribe"><a href="/feed.xml"><span class="nav-panel__item-label">RSS feed</span><span class="nav-panel__item-desc">Subscribe to the blog.</span></a></li>
        <li class="nav-panel__item" data-haystack="github source code repo"><a href="{{ site.repo }}" target="_blank" rel="noopener"><span class="nav-panel__item-label">GitHub repo ↗</span><span class="nav-panel__item-desc">Source, MIT licensed.</span></a></li>
        <li class="nav-panel__item" data-haystack="github issues bug report"><a href="{{ site.repo }}/issues" target="_blank" rel="noopener"><span class="nav-panel__item-label">Report a bug ↗</span><span class="nav-panel__item-desc">File an issue on GitHub.</span></a></li>
        <li class="nav-panel__item" data-haystack="privacy policy data"><a href="/privacy/"><span class="nav-panel__item-label">Privacy</span><span class="nav-panel__item-desc">Privacy-first analytics, no cookies.</span></a></li>
        <li class="nav-panel__item" data-haystack="terms of use"><a href="/terms/"><span class="nav-panel__item-label">Terms</span><span class="nav-panel__item-desc">Plain-English terms of use.</span></a></li>
        <li class="nav-panel__item" data-haystack="license mit open source"><a href="/license/"><span class="nav-panel__item-label">License</span><span class="nav-panel__item-desc">MIT for code, public domain for content.</span></a></li>
      </ul>
    </details>
  </nav>

  <div class="nav-panel__theme">
    <span class="nav-panel__theme-label">Theme</span>
    <button type="button" class="nav-panel__theme-btn" onclick="window.toggleTheme && window.toggleTheme()" aria-label="Toggle day / night">
      <svg class="nav-panel__theme-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="nav-panel__theme-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span class="nav-panel__theme-text">Switch</span>
    </button>
  </div>

  <footer class="nav-panel__foot">
    <a class="nav-panel__foot-link" href="{{ site.repo }}" target="_blank" rel="noopener" aria-label="GitHub">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.7-1.4-1.7-1.1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1.1 1.9 2.9 1.4 3.6 1 .1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.3 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.9 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
      <span>GitHub</span>
    </a>
    <a class="nav-panel__foot-link" href="/feed.xml" aria-label="RSS feed">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M5 21a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm-1.5-13a13.5 13.5 0 0 1 13.5 13.5h-3A10.5 10.5 0 0 0 3.5 11Zm0-6A19.5 19.5 0 0 1 23 24.5h-3A16.5 16.5 0 0 0 3.5 8Z"/></svg>
      <span>RSS</span>
    </a>
    <a class="nav-panel__foot-link" href="/contact/" aria-label="Contact">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span>Contact</span>
    </a>
    <a class="nav-panel__foot-link" href="/contribute/" aria-label="Contribute">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10Z"/></svg>
      <span>Contribute</span>
    </a>
  </footer>
</aside>
<div id="nav-panel-scrim" class="nav-panel__scrim" hidden onclick="window.closeNavPanel && window.closeNavPanel()"></div>
