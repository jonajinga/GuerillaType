<div class="mode-bar" role="tablist" aria-label="Practice settings">
  <div class="mode-bar__field" role="group" aria-label="Mode" data-group="mode">
    {# Each split-button = mode chip + chevron. The chip selects the
       mode; the chevron opens a dropdown with that mode's specific
       options. Modes without rich options (zen / adaptive / random)
       don't get a chevron. #}
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="time" aria-pressed="true" data-tip="<strong>Time mode</strong><br>Type as much as you can before the clock runs out.">time</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="time" aria-haspopup="true" aria-expanded="false" aria-label="Time options" data-tip="Configure duration + source." onclick="window.ttToggleDropdown && window.ttToggleDropdown('time', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="words" data-tip="<strong>Words mode</strong><br>Type a fixed count of words.">words</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="words" aria-haspopup="true" aria-expanded="false" aria-label="Words options" data-tip="Configure count + source." onclick="window.ttToggleDropdown && window.ttToggleDropdown('words', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="quote" data-section-url="/quotes/" data-tip="<strong>Quote mode</strong><br>Curated literary quotes. On mobile this opens the full quotes index.">quote</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="quote" aria-haspopup="true" aria-expanded="false" aria-label="Quote options" data-tip="Configure length + source." onclick="window.ttToggleDropdown && window.ttToggleDropdown('quote', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="idiom" data-section-url="/idioms/" data-tip="<strong>Idiom</strong><br>Random English idiom with its meaning. On mobile this opens the full idioms index.">idiom</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="idiom" aria-haspopup="true" aria-expanded="false" aria-label="Idiom options" data-tip="Filter idioms by region." onclick="window.ttToggleDropdown && window.ttToggleDropdown('idiom', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="poem" data-section-url="/poetry/" data-tip="<strong>Poetry</strong><br>Random public-domain poem. On mobile this opens the full poetry index.">poem</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="poem" aria-haspopup="true" aria-expanded="false" aria-label="Poem options" data-tip="Filter poems by era or length." onclick="window.ttToggleDropdown && window.ttToggleDropdown('poem', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <button type="button" class="mode-bar__btn" data-mode="tape" data-tip="<strong>Tape mode</strong><br>Words scroll horizontally like a ticker. 15-second sprint by default.">tape</button>
    <button type="button" class="mode-bar__btn" data-mode="zen" data-tip="<strong>Zen mode</strong><br>Untimed, endless. Press Esc to stop.">zen</button>
    <button type="button" class="mode-bar__btn" data-mode="custom" data-tip="<strong>Custom text</strong><br>Type your own pasted text or saved snippets.">custom</button>
    <button type="button" class="mode-bar__btn" data-mode="adaptive" data-tip="<strong>Adaptive mode</strong><br>Picker biased toward your weakest keys + bigrams.">adaptive</button>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" onclick="window.location.href='/drills/'" data-tip="<strong>Drills</strong><br>Browse and pick a key-cluster or bigram drill.">drills</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="drills" aria-haspopup="true" aria-expanded="false" aria-label="Drills options" data-tip="Jump to a drill category." onclick="window.ttToggleDropdown && window.ttToggleDropdown('drills', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" onclick="window.location.href='/challenges/'" data-tip="<strong>Challenges</strong><br>Browse and pick a structured challenge with a goal.">challenges</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="challenges" aria-haspopup="true" aria-expanded="false" aria-label="Challenges options" data-tip="Jump to a challenge difficulty." onclick="window.ttToggleDropdown && window.ttToggleDropdown('challenges', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <button type="button" class="mode-bar__btn mode-bar__btn--random" onclick="window.ttRandomMode && window.ttRandomMode()" data-tip="<strong>Random mode</strong><br>Surprise me with a random mode + variant.">random</button>
    <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/game/'" data-tip="<strong>Catch the Word</strong><br>Mini-game built on your missed-words list. Words fall, type them before they hit bottom.">game</button>
  </div>

  {# Dropdown panels. One per mode that has rich options. Hidden by
     default; the JS in practice-boot.js opens the matching panel
     when its chevron is clicked. Each panel groups variant + source
     + modifier controls. The variant rows reuse the existing
     data-duration / data-words / data-quote attributes so the mode-
     bar binding picks them up automatically. #}
  <div class="mode-bar__dropdown" data-dropdown="time" hidden role="region" aria-label="Time mode settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Duration · seconds</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-duration="15" data-tip="15-second sprint.">15</button>
        <button type="button" class="mode-bar__btn" data-duration="30" aria-pressed="true" data-tip="The classic benchmark.">30</button>
        <button type="button" class="mode-bar__btn" data-duration="60" data-tip="One-minute test.">60</button>
        <button type="button" class="mode-bar__btn" data-duration="120" data-tip="Two-minute sustained pace.">120</button>
        <button type="button" class="mode-bar__btn" data-duration="300" data-tip="Five-minute endurance.">300</button>
        <input type="number" class="mode-bar__custom" data-custom="duration" min="5" max="3600" step="5" placeholder="…" aria-label="Custom duration in seconds" data-tip="Custom duration (5-3600 s).">
      </div>
    </div>
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Source</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-lang="en-1k" aria-pressed="true" data-tip="Top 1,000 English words.">en-1k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-5k" data-tip="Top 5,000 English words.">en-5k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-10k" data-tip="Top 10,000 English words.">en-10k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-20k" data-tip="Top 20,000 English words.">en-20k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-50k" data-tip="Top 50,000 English words. Includes rare vocabulary.">en-50k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-advanced" data-tip="Hard / advanced English vocabulary.">advanced</button>
        <button type="button" class="mode-bar__btn" data-lang="numbers" data-tip="Digits only.">numbers</button>
        <button type="button" class="mode-bar__btn" data-lang="punctuation" data-tip="Punctuation-heavy words.">punctuation</button>
        <button type="button" class="mode-bar__btn" data-lang="capitals" data-tip="Capitalized proper nouns + acronyms.">capitals</button>
        <button type="button" class="mode-bar__btn" data-lang="countries" data-tip="World country names.">countries</button>
        <button type="button" class="mode-bar__btn" data-lang="latin-phrases" data-tip="Latin phrases.">latin</button>
        <button type="button" class="mode-bar__btn" data-lang="code-js" data-tip="JavaScript keywords + idioms.">code-js</button>
        <button type="button" class="mode-bar__btn" data-lang="code-py" data-tip="Python keywords + idioms.">code-py</button>
        <button type="button" class="mode-bar__btn" data-lang="code-ts" data-tip="TypeScript keywords + idioms.">code-ts</button>
        <button type="button" class="mode-bar__btn" data-lang="code-html" data-tip="HTML tags + attributes.">code-html</button>
        <button type="button" class="mode-bar__btn" data-lang="code-css" data-tip="CSS properties + selectors.">code-css</button>
        <button type="button" class="mode-bar__btn" data-lang="code-bash" data-tip="Bash / shell commands.">code-bash</button>
        <button type="button" class="mode-bar__btn" data-lang="code-sql" data-tip="SQL keywords.">code-sql</button>
        <button type="button" class="mode-bar__btn" data-lang="code-rust" data-tip="Rust keywords + idioms.">code-rust</button>
        <button type="button" class="mode-bar__btn" data-lang="missed" data-tip="Your missed-words list, weighted by miss count.">missed</button>
        <button type="button" class="mode-bar__btn" data-lang="misspellings" data-tip="Commonly misspelled words.">misspellings</button>
        <button type="button" class="mode-bar__btn" data-lang="scrabble" data-tip="High-scoring Scrabble words.">scrabble</button>
        <button type="button" class="mode-bar__btn" data-lang="pangrams" data-tip="Sentences using every letter.">pangrams</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="words" hidden role="region" aria-label="Words mode settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Count</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-words="10" data-tip="Quick warm-up.">10</button>
        <button type="button" class="mode-bar__btn" data-words="25" aria-pressed="true" data-tip="Most common length.">25</button>
        <button type="button" class="mode-bar__btn" data-words="50" data-tip="Middle distance.">50</button>
        <button type="button" class="mode-bar__btn" data-words="100" data-tip="Sustained focus.">100</button>
        <input type="number" class="mode-bar__custom" data-custom="words" min="1" max="2000" step="1" placeholder="…" aria-label="Custom word count" data-tip="Custom word count (1-2000).">
      </div>
    </div>
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Source</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-lang="en-1k" aria-pressed="true" data-tip="Top 1,000 English words.">en-1k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-5k" data-tip="Top 5,000 English words.">en-5k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-10k" data-tip="Top 10,000 English words.">en-10k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-20k" data-tip="Top 20,000 English words.">en-20k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-50k" data-tip="Top 50,000 English words. Includes rare vocabulary.">en-50k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-advanced" data-tip="Hard / advanced English vocabulary.">advanced</button>
        <button type="button" class="mode-bar__btn" data-lang="numbers" data-tip="Digits only.">numbers</button>
        <button type="button" class="mode-bar__btn" data-lang="punctuation" data-tip="Punctuation-heavy words.">punctuation</button>
        <button type="button" class="mode-bar__btn" data-lang="capitals" data-tip="Capitalized proper nouns + acronyms.">capitals</button>
        <button type="button" class="mode-bar__btn" data-lang="countries" data-tip="World country names.">countries</button>
        <button type="button" class="mode-bar__btn" data-lang="latin-phrases" data-tip="Latin phrases.">latin</button>
        <button type="button" class="mode-bar__btn" data-lang="code-js" data-tip="JavaScript keywords + idioms.">code-js</button>
        <button type="button" class="mode-bar__btn" data-lang="code-py" data-tip="Python keywords + idioms.">code-py</button>
        <button type="button" class="mode-bar__btn" data-lang="code-ts" data-tip="TypeScript keywords + idioms.">code-ts</button>
        <button type="button" class="mode-bar__btn" data-lang="code-html" data-tip="HTML tags + attributes.">code-html</button>
        <button type="button" class="mode-bar__btn" data-lang="code-css" data-tip="CSS properties + selectors.">code-css</button>
        <button type="button" class="mode-bar__btn" data-lang="code-bash" data-tip="Bash / shell commands.">code-bash</button>
        <button type="button" class="mode-bar__btn" data-lang="code-sql" data-tip="SQL keywords.">code-sql</button>
        <button type="button" class="mode-bar__btn" data-lang="code-rust" data-tip="Rust keywords + idioms.">code-rust</button>
        <button type="button" class="mode-bar__btn" data-lang="missed" data-tip="Your missed-words list, weighted by miss count.">missed</button>
        <button type="button" class="mode-bar__btn" data-lang="misspellings" data-tip="Commonly misspelled words.">misspellings</button>
        <button type="button" class="mode-bar__btn" data-lang="scrabble" data-tip="High-scoring Scrabble words.">scrabble</button>
        <button type="button" class="mode-bar__btn" data-lang="pangrams" data-tip="Sentences using every letter.">pangrams</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="quote" hidden role="region" aria-label="Quote mode settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Length</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-quote="short" data-tip="Under 80 characters. Aphorisms.">short</button>
        <button type="button" class="mode-bar__btn" data-quote="medium" aria-pressed="true" data-tip="Under 200 characters. The default.">medium</button>
        <button type="button" class="mode-bar__btn" data-quote="long" data-tip="200+ characters. Paragraph-length.">long</button>
        <button type="button" class="mode-bar__btn" data-quote="random" data-tip="Any length, random pick.">random</button>
      </div>
    </div>
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Tag</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-tag="" aria-pressed="true" data-tip="Any tag.">any</button>
        <button type="button" class="mode-bar__btn" data-tag="philosophy" data-tip="Philosophy + stoicism.">philosophy</button>
        <button type="button" class="mode-bar__btn" data-tag="literature" data-tip="From poets, novelists, playwrights.">literature</button>
        <button type="button" class="mode-bar__btn" data-tag="science" data-tip="Scientists, mathematicians.">science</button>
        <button type="button" class="mode-bar__btn" data-tag="humor" data-tip="Funny / irreverent.">humor</button>
        <button type="button" class="mode-bar__btn" data-tag="motivation" data-tip="Motivational.">motivation</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="idiom" hidden role="region" aria-label="Idiom settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Click any tag below for a random pick</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?mode=idiom'" data-tip="Any idiom.">any</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/idioms/'" data-tip="Browse the full idiom index.">browse all</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="poem" hidden role="region" aria-label="Poem settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Click any option for a random pick</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?mode=poem'" data-tip="Any poem from the public-domain corpus.">any</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/poetry/'" data-tip="Browse the full poetry index.">browse all</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="drills" hidden role="region" aria-label="Drill categories">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Jump to a category</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/drills/'" data-tip="All drills.">all</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?drill=home-row'" data-tip="Home-row drill.">home row</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?drill=top-row'" data-tip="Top-row drill.">top row</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?drill=bottom-row'" data-tip="Bottom-row drill.">bottom row</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?drill=numbers'" data-tip="Number row drill.">numbers</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?drill=symbols'" data-tip="Symbol cluster drill.">symbols</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="challenges" hidden role="region" aria-label="Challenge categories">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Browse challenges</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/challenges/'" data-tip="All challenges.">all</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?challenge=sprint'" data-tip="60 second sprint -- hit 60 wpm at 95%.">sprint</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?challenge=word-500'" data-tip="Endurance -- 500 words at 60 wpm.">endurance</button>
        <button type="button" class="mode-bar__btn" onclick="window.location.href='/practice/?challenge=accuracy-only'" data-tip="100 words at >= 99% accuracy.">accuracy</button>
      </div>
    </div>
  </div>
</div>
