<div class="mode-bar" role="tablist" aria-label="Practice settings">
  <div class="mode-bar__field" role="group" aria-label="Mode" data-group="mode">
    {# Each split-button = mode chip + chevron. The chip selects the
       mode; the chevron opens a dropdown with that mode's specific
       options. Modes without rich options (zen / adaptive / random)
       don't get a chevron. #}
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="time" aria-pressed="true" data-tip="<strong>Time mode</strong><br>Type as much as you can before the clock runs out.">time</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="time" aria-haspopup="true" aria-expanded="false" aria-label="Time options" data-tip="Configure duration + source." onclick="window.ttToggleDropdown && window.ttToggleDropdown('time', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="words" data-tip="<strong>Words mode</strong><br>Type a fixed count of words.">words</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="words" aria-haspopup="true" aria-expanded="false" aria-label="Words options" data-tip="Configure count + source." onclick="window.ttToggleDropdown && window.ttToggleDropdown('words', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <span class="mode-bar__split">
      <button type="button" class="mode-bar__btn" data-mode="quote" data-tip="<strong>Quote mode</strong><br>Curated literary quotes.">quote</button>
      <button type="button" class="mode-bar__chev" data-dropdown-trigger="quote" aria-haspopup="true" aria-expanded="false" aria-label="Quote options" data-tip="Configure length + source." onclick="window.ttToggleDropdown && window.ttToggleDropdown('quote', event)">
        <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </button>
    </span>
    <button type="button" class="mode-bar__btn" data-mode="idiom" data-tip="<strong>Idiom</strong><br>Random English idiom with its meaning.">idiom</button>
    <button type="button" class="mode-bar__btn" data-mode="poem" data-tip="<strong>Poetry</strong><br>Random public-domain poem.">poem</button>
    <button type="button" class="mode-bar__btn" data-mode="zen" data-tip="<strong>Zen mode</strong><br>Untimed, endless. Press Esc to stop.">zen</button>
    <button type="button" class="mode-bar__btn" data-mode="custom" data-tip="<strong>Custom text</strong><br>Type your own pasted text or saved snippets.">custom</button>
    <button type="button" class="mode-bar__btn" data-mode="adaptive" data-tip="<strong>Adaptive mode</strong><br>Picker biased toward your weakest keys + bigrams.">adaptive</button>
    <button type="button" class="mode-bar__btn" onclick="window.location.href='/drills/'" data-tip="<strong>Drills</strong><br>Browse and pick a key-cluster or bigram drill.">drills</button>
    <button type="button" class="mode-bar__btn" onclick="window.location.href='/challenges/'" data-tip="<strong>Challenges</strong><br>Browse and pick a structured challenge with a goal.">challenges</button>
    <button type="button" class="mode-bar__btn mode-bar__btn--random" onclick="window.ttRandomMode && window.ttRandomMode()" data-tip="<strong>Random mode</strong><br>Surprise me with a random mode + variant.">random</button>
  </div>

  {# Dropdown panels. One per mode that has rich options. Hidden by
     default; the JS in practice-boot.js opens the matching panel
     when its chevron is clicked. Each panel groups variant + source
     + modifier controls. The variant rows reuse the existing
     data-duration / data-words / data-quote attributes so the mode-
     bar binding picks them up automatically. #}
  <div class="mode-bar__dropdown" data-dropdown="time" hidden role="region" aria-label="Time mode settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Duration · seconds</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-duration="15" data-tip="15-second sprint.">15</button>
        <button type="button" class="mode-bar__btn" data-duration="30" aria-pressed="true" data-tip="The classic benchmark.">30</button>
        <button type="button" class="mode-bar__btn" data-duration="60" data-tip="One-minute test.">60</button>
        <button type="button" class="mode-bar__btn" data-duration="120" data-tip="Two-minute sustained pace.">120</button>
        <button type="button" class="mode-bar__btn" data-duration="300" data-tip="Five-minute endurance.">300</button>
        <input type="number" class="mode-bar__custom" data-custom="duration" min="5" max="3600" step="5" placeholder="…" aria-label="Custom duration in seconds" data-tip="Custom duration (5-3600 s).">
      </div>
    </div>
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Source</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-lang="en-1k" aria-pressed="true" data-tip="Top 1,000 English words.">en-1k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-5k" data-tip="Top 5,000 English words.">en-5k</button>
        <button type="button" class="mode-bar__btn" data-lang="numbers" data-tip="Digits only.">numbers</button>
        <button type="button" class="mode-bar__btn" data-lang="code-js" data-tip="JavaScript keywords + idioms.">code-js</button>
        <button type="button" class="mode-bar__btn" data-lang="code-py" data-tip="Python keywords + idioms.">code-py</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="words" hidden role="region" aria-label="Words mode settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Count</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-words="10" data-tip="Quick warm-up.">10</button>
        <button type="button" class="mode-bar__btn" data-words="25" aria-pressed="true" data-tip="Most common length.">25</button>
        <button type="button" class="mode-bar__btn" data-words="50" data-tip="Middle distance.">50</button>
        <button type="button" class="mode-bar__btn" data-words="100" data-tip="Sustained focus.">100</button>
        <input type="number" class="mode-bar__custom" data-custom="words" min="1" max="2000" step="1" placeholder="…" aria-label="Custom word count" data-tip="Custom word count (1-2000).">
      </div>
    </div>
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Source</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-lang="en-1k" aria-pressed="true" data-tip="Top 1,000 English words.">en-1k</button>
        <button type="button" class="mode-bar__btn" data-lang="en-5k" data-tip="Top 5,000 English words.">en-5k</button>
        <button type="button" class="mode-bar__btn" data-lang="numbers" data-tip="Digits only.">numbers</button>
        <button type="button" class="mode-bar__btn" data-lang="code-js" data-tip="JavaScript keywords + idioms.">code-js</button>
        <button type="button" class="mode-bar__btn" data-lang="code-py" data-tip="Python keywords + idioms.">code-py</button>
      </div>
    </div>
  </div>

  <div class="mode-bar__dropdown" data-dropdown="quote" hidden role="region" aria-label="Quote mode settings">
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Length</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-quote="short" data-tip="Under 80 characters. Aphorisms.">short</button>
        <button type="button" class="mode-bar__btn" data-quote="medium" aria-pressed="true" data-tip="Under 200 characters. The default.">medium</button>
        <button type="button" class="mode-bar__btn" data-quote="long" data-tip="200+ characters. Paragraph-length.">long</button>
        <button type="button" class="mode-bar__btn" data-quote="random" data-tip="Any length, random pick.">random</button>
      </div>
    </div>
    <div class="mode-bar__dropdown-section">
      <p class="mode-bar__dropdown-eyebrow">Tag</p>
      <div class="mode-bar__dropdown-row">
        <button type="button" class="mode-bar__btn" data-tag="" aria-pressed="true" data-tip="Any tag.">any</button>
        <button type="button" class="mode-bar__btn" data-tag="philosophy" data-tip="Philosophy + stoicism.">philosophy</button>
        <button type="button" class="mode-bar__btn" data-tag="literature" data-tip="From poets, novelists, playwrights.">literature</button>
        <button type="button" class="mode-bar__btn" data-tag="science" data-tip="Scientists, mathematicians.">science</button>
        <button type="button" class="mode-bar__btn" data-tag="humor" data-tip="Funny / irreverent.">humor</button>
        <button type="button" class="mode-bar__btn" data-tag="motivation" data-tip="Motivational.">motivation</button>
      </div>
    </div>
  </div>
</div>
