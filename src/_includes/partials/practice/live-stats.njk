<div id="tt-live" class="live-stats" aria-live="polite" aria-label="Live stats">
  <div class="live-stats__metric" data-tip="<strong>Net WPM</strong><br>(correctChars ÷ 5) ÷ minutes. The standard typing speed metric.">
    <span class="live-stats__value tabular" data-live="wpm">0</span>
    <span class="live-stats__label">wpm</span>
  </div>
  <div class="live-stats__metric" data-tip="<strong>Accuracy</strong><br>Correct keystrokes ÷ total keystrokes. Backspaces don't undo the original press.">
    <span class="live-stats__value tabular" data-live="acc">100</span>
    <span class="live-stats__label">accuracy</span>
  </div>
  <div class="live-stats__metric" data-tip="<strong>Time / progress</strong><br>Seconds remaining in time mode, words remaining in words/quote mode.">
    <span class="live-stats__value tabular" data-live="time">30</span>
    <span class="live-stats__label" data-live-label="time">seconds left</span>
  </div>
</div>
<div class="timer-bar" aria-hidden="true"><div id="tt-timer-fill" class="timer-bar__fill"></div></div>
