{# Sticky practice toolbar — anchored below the site header.
   Three regions: mode/variant selectors on the left, a center spacer
   that grows the toolbar to full width, and live stats on the right. #}
<div class="practice-bar" data-practice-bar>
  <div class="practice-bar__inner" id="tt-bar-inner">
    <div class="practice-bar__stats">
      {% include "partials/practice/live-stats.njk" %}
    </div>
    <div class="practice-bar__challenge" id="tt-challenge-pill" hidden></div>
    <div class="practice-bar__modes">
      {% include "partials/practice/mode-bar.njk" %}
    </div>
  </div>
  {# Mobile-only scroll affordances. Anchored to the practice-bar so
     they stay put while the inner content slides under them. JS shows
     / hides them based on the inner's scrollLeft + scrollWidth. #}
  <button type="button" class="practice-bar__scroll practice-bar__scroll--prev" id="tt-bar-prev" aria-label="Scroll toolbar left">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
  </button>
  <button type="button" class="practice-bar__scroll practice-bar__scroll--next" id="tt-bar-next" aria-label="Scroll toolbar right">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </button>
  <div class="practice-bar__progress" id="tt-progress-fill" aria-hidden="true"></div>
</div>
<script>
/* Practice-bar mobile scroll arrows. The inner strip is horizontally
   scrollable on mobile; these chevrons let the user nudge it left or
   right by a chip's worth at a tap. Visibility tracks scroll position. */
(function(){
  var bar = document.getElementById("tt-bar-inner");
  var prev = document.getElementById("tt-bar-prev");
  var next = document.getElementById("tt-bar-next");
  if (!bar || !prev || !next) return;
  function update(){
    var max = bar.scrollWidth - bar.clientWidth;
    if (max <= 4) { prev.dataset.show = "false"; next.dataset.show = "false"; return; }
    prev.dataset.show = bar.scrollLeft > 4 ? "true" : "false";
    next.dataset.show = bar.scrollLeft < max - 4 ? "true" : "false";
  }
  function nudge(dir){
    bar.scrollBy({ left: dir * Math.max(120, bar.clientWidth * 0.6), behavior: "smooth" });
  }
  prev.addEventListener("click", function(){ nudge(-1); });
  next.addEventListener("click", function(){ nudge(1); });
  bar.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  // Initial paint after fonts/layout settle.
  setTimeout(update, 50);
  setTimeout(update, 300);
})();
</script>

<div class="practice-page">
  {# Contextual back link — populated by practice-boot based on the
     mode/source of the current session (book, quote, idiom, parable,
     poem, custom). Hidden by default. #}
  <a id="tt-back-link" class="tt-back-link" hidden></a>

  {# Synchronous flip to data-focused="false" on touch devices. Runs
     before paint so the user never sees the brief "focused with
     cursor blinking" flash before the engine boots. The same
     predicate as isMobileLike() in typing-engine.js. #}
  <script>
    (function(){
      try{
        var w = window;
        var touch = false;
        if (w.matchMedia){
          if (w.matchMedia("(max-width: 767px)").matches) touch = true;
          else if (w.matchMedia("(hover: none) and (pointer: coarse)").matches) touch = true;
          else if (w.matchMedia("(pointer: coarse)").matches) touch = true;
        }
        if (!touch && "ontouchstart" in w) touch = true;
        if (!touch && navigator.maxTouchPoints > 0) touch = true;
        if (!touch && /iphone|ipad|ipod|android/i.test(navigator.userAgent || "")) touch = true;
        if (touch) document.documentElement.setAttribute("data-touch", "true");
      }catch(e){}
    })();
  </script>
  {# Default to data-focused="false". On desktop the engine focuses
     the input on boot, the focus event flips it to true. On touch
     devices it stays false until the user taps -- which is exactly
     what we want, no flash of focused state with a blinking caret. #}
  <div id="tt-stage" class="tt-stage" data-mode="time" data-state="idle" data-focused="false">
    {# Aggressive autofill suppression. iOS Safari ignores plain
       autocomplete="off" on text inputs; pile on every known signal
       so password managers (1Password, LastPass, Bitwarden, Dashlane)
       and the Safari QuickType bar all stay out of the way. The input
       has no `name` attribute on purpose -- without a name, browsers
       have nothing to autofill against. enterkeyhint="done" replaces
       the "go" button on the soft keyboard with a softer cap. #}
    <input id="tt-input" class="tt-input" type="text"
           autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
           inputmode="text" enterkeyhint="done"
           aria-label="Typing input" aria-autocomplete="none"
           data-form-type="other" data-1p-ignore="" data-lpignore="true" data-bwignore="true">
    <div id="tt-text" class="tt-text" aria-live="off"></div>
    <p id="tt-hint" class="tt-stage__hint" aria-live="polite">Loading…</p>
  </div>

  {% include "partials/practice/live-keyboard.njk" %}

  <div class="practice-page__bottom">
    <div class="tt-actions">
      <button type="button" class="btn btn--small tt-actions__btn" id="tt-restart" onclick="window.ttRestart && window.ttRestart()" aria-label="Restart this session" data-tip="<strong>Restart this session</strong><br>Or press <kbd>Tab</kbd> then <kbd>Enter</kbd> on the typing surface.">
        <svg class="tt-actions__icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        <span class="tt-actions__label">Restart</span>
      </button>
      <button type="button" class="btn btn--small tt-actions__btn tt-actions__btn--stop" id="tt-stop" onclick="window.ttFinish && window.ttFinish()" aria-label="End this session and see your results" data-tip="<strong>End this session</strong><br>Stops the timer, saves whatever you typed, and shows your results. (Same as pressing <kbd>Esc</kbd> on desktop.)">
        <svg class="tt-actions__icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="5" width="14" height="14" rx="1.5"/></svg>
        <span class="tt-actions__label">Stop</span>
      </button>
      <button type="button" class="btn btn--small btn--ghost tt-actions__btn" onclick="window.openInfoModal && window.openInfoModal('practice')" aria-label="How the practice surface works" data-tip="<strong>How the practice surface works</strong><br>Modes, scoring, and what the live stats mean.">
        <svg class="tt-actions__icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-.7.5-1.5 1-1.5 2"/><circle cx="12" cy="17" r="0.6" fill="currentColor"/></svg>
        <span class="tt-actions__label">How it works ↗</span>
      </button>
      <button type="button" class="btn btn--small btn--ghost tt-actions__btn" onclick="window.openFeedbackModal && window.openFeedbackModal()" aria-label="Send feedback" data-tip="<strong>Send a quick note</strong><br>Topic + message. Doesn't leave this page or interrupt your session.">
        <svg class="tt-actions__icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg>
        <span class="tt-actions__label">Send feedback ↗</span>
      </button>
      <span class="tt-actions__hint">
        <span class="tt-actions__hint-group" data-tip="<strong>Restart the test</strong><br>Press <kbd>Tab</kbd> to arm the prompt, then <kbd>Enter</kbd> within 2 seconds to confirm. Any other key cancels."><kbd>Tab</kbd> <kbd>Enter</kbd> <em>restart</em></span>
        <span class="tt-actions__hint-group" data-tip="<strong>End the session</strong><br>Saves whatever you typed and returns to the toolbar."><kbd>Esc</kbd> <em>end session</em></span>
        <span class="tt-actions__hint-group" data-tip="<strong>Open site search</strong><br>Find any page or quote across the site."><kbd>Ctrl</kbd>+<kbd>K</kbd> <em>search</em></span>
      </span>
    </div>
  </div>

  <div id="tt-results" class="results" hidden></div>
</div>
