{# Sticky practice toolbar — anchored below the site header.
   Three regions: mode/variant selectors on the left, a center spacer
   that grows the toolbar to full width, and live stats on the right. #}
<div class="practice-bar" data-practice-bar>
  <div class="practice-bar__inner" id="tt-bar-inner">
    <div class="practice-bar__stats">
      {% include "partials/practice/live-stats.njk" %}
    </div>
    <div class="practice-bar__challenge" id="tt-challenge-pill" hidden></div>
    <div class="practice-bar__modes">
      {% include "partials/practice/mode-bar.njk" %}
    </div>
  </div>
  {# Mobile-only scroll affordances. Anchored to the practice-bar so
     they stay put while the inner content slides under them. JS shows
     / hides them based on the inner's scrollLeft + scrollWidth. #}
  <button type="button" class="practice-bar__scroll practice-bar__scroll--prev" id="tt-bar-prev" aria-label="Scroll toolbar left">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
  </button>
  <button type="button" class="practice-bar__scroll practice-bar__scroll--next" id="tt-bar-next" aria-label="Scroll toolbar right">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </button>
  <div class="practice-bar__progress" id="tt-progress-fill" aria-hidden="true"></div>
</div>
<script>
/* Practice-bar mobile scroll arrows. The inner strip is horizontally
   scrollable on mobile; these chevrons let the user nudge it left or
   right by a chip's worth at a tap. Visibility tracks scroll position. */
(function(){
  var bar = document.getElementById("tt-bar-inner");
  var prev = document.getElementById("tt-bar-prev");
  var next = document.getElementById("tt-bar-next");
  if (!bar || !prev || !next) return;
  function update(){
    var max = bar.scrollWidth - bar.clientWidth;
    if (max <= 4) { prev.dataset.show = "false"; next.dataset.show = "false"; return; }
    prev.dataset.show = bar.scrollLeft > 4 ? "true" : "false";
    next.dataset.show = bar.scrollLeft < max - 4 ? "true" : "false";
  }
  function nudge(dir){
    bar.scrollBy({ left: dir * Math.max(120, bar.clientWidth * 0.6), behavior: "smooth" });
  }
  prev.addEventListener("click", function(){ nudge(-1); });
  next.addEventListener("click", function(){ nudge(1); });
  bar.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  // Initial paint after fonts/layout settle.
  setTimeout(update, 50);
  setTimeout(update, 300);
})();
</script>

<div class="practice-page">
  {# Contextual back link — populated by practice-boot based on the
     mode/source of the current session (book, quote, idiom, parable,
     poem, custom). Hidden by default. #}
  <a id="tt-back-link" class="tt-back-link" hidden></a>

  <div id="tt-stage" class="tt-stage" data-mode="time" data-state="idle" data-focused="true">
    <input id="tt-input" class="tt-input" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" inputmode="text" aria-label="Typing input">
    <div id="tt-text" class="tt-text" aria-live="off"></div>
    <p id="tt-hint" class="tt-stage__hint" aria-live="polite">Loading…</p>
  </div>

  {% include "partials/practice/live-keyboard.njk" %}

  <div class="practice-page__bottom">
    <div class="tt-actions">
      <button type="button" class="btn btn--small" id="tt-restart" onclick="window.ttRestart && window.ttRestart()" data-tip="<strong>Restart this session</strong><br>Or press <kbd>Tab</kbd> then <kbd>Enter</kbd> on the typing surface.">Restart</button>
      <button type="button" class="btn btn--small btn--ghost" onclick="window.openInfoModal && window.openInfoModal('practice')" data-tip="<strong>How the practice surface works</strong><br>Modes, scoring, and what the live stats mean.">How it works ↗</button>
      <button type="button" class="btn btn--small btn--ghost" onclick="window.openFeedbackModal && window.openFeedbackModal()" data-tip="<strong>Send a quick note</strong><br>Topic + message. Doesn't leave this page or interrupt your session.">Send feedback ↗</button>
      <span class="tt-actions__hint">
        <span class="tt-actions__hint-group" data-tip="<strong>Restart the test</strong><br>Press <kbd>Tab</kbd> to arm the prompt, then <kbd>Enter</kbd> within 2 seconds to confirm. Any other key cancels."><kbd>Tab</kbd> <kbd>Enter</kbd> <em>restart</em></span>
        <span class="tt-actions__hint-group" data-tip="<strong>End the session</strong><br>Saves whatever you typed and returns to the toolbar."><kbd>Esc</kbd> <em>end session</em></span>
        <span class="tt-actions__hint-group" data-tip="<strong>Open site search</strong><br>Find any page or quote across the site."><kbd>Ctrl</kbd>+<kbd>K</kbd> <em>search</em></span>
      </span>
    </div>
  </div>

  <div id="tt-results" class="results" hidden></div>
</div>
