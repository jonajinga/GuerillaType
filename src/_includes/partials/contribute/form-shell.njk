{# Macro library for /contribute/<kind>/ forms. Each form page renders
   its own body using these helpers, so the chrome stays in one place
   while each form keeps full control of its specific fields.

   Usage in a page:
     {% import "partials/contribute/form-shell.njk" as cf %}
     {{ cf.head(...) }}
     <form class="contribute-form" method="POST" action="{{ web3forms.endpoint }}">
       {{ cf.hidden(kind="quote", subject="GT contribution: quote") }}
       {{ cf.text(name="quote_author", label="Author", required=true) }}
       …
       {{ cf.submit("Send suggestion") }}
     </form>
#}

{% macro head(formTitle, blurb, kind) %}
<a class="tt-back-link" href="/contribute/">← All contribution forms</a>
<header class="contribute-page__head">
  <p class="eyebrow">Contribute · {{ kind }}</p>
  <h1>{{ formTitle }}</h1>
  {% if blurb %}<p class="article-lede">{{ blurb }}</p>{% endif %}
</header>
{% endmacro %}

{% macro byline() %}
<aside class="contribute-page__byline">
  <a href="https://jonajinga.com" target="_blank" rel="noopener" class="contribute-page__byline-photo" aria-label="Jon Ajinga">
    {# Async {% image %} shortcodes don't resolve inside Nunjucks
       macros, so we reference the pre-baked fixed-name variants
       generated by the eleventy.before hook in eleventy.config.js. #}
    <picture>
      <source type="image/avif" srcset="/assets/img/_gen/jon-ajinga-120.avif 1x, /assets/img/_gen/jon-ajinga-240.avif 2x, /assets/img/_gen/jon-ajinga-360.avif 3x">
      <source type="image/webp" srcset="/assets/img/_gen/jon-ajinga-120.webp 1x, /assets/img/_gen/jon-ajinga-240.webp 2x, /assets/img/_gen/jon-ajinga-360.webp 3x">
      <img src="/assets/img/_gen/jon-ajinga-120.jpeg"
           srcset="/assets/img/_gen/jon-ajinga-120.jpeg 1x, /assets/img/_gen/jon-ajinga-240.jpeg 2x, /assets/img/_gen/jon-ajinga-360.jpeg 3x"
           alt="Jon Ajinga" width="120" height="120" loading="lazy" decoding="async">
    </picture>
  </a>
  <p>I'm <a href="https://jonajinga.com" target="_blank" rel="noopener">Jon</a>. Submissions come straight to me. I read every one.</p>
</aside>
{% endmacro %}

{% macro hidden(kind, subject, web3forms) %}
<input type="hidden" name="access_key" value="{{ web3forms.accessKey }}">
<input type="hidden" name="subject" value="{{ subject }}">
<input type="hidden" name="from_name" value="guerillatype.com">
<input type="hidden" name="contribution_kind" value="{{ kind }}">
<input type="hidden" name="redirect" value="{{ web3forms.redirectBase }}?for={{ kind }}">
<input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true">
{% endmacro %}

{% macro text(name, label, required=false, maxlength=200, hint="", placeholder="", autocomplete="off", type="text", pattern="") %}
<div class="field">
  <label for="cf-{{ name }}">{{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}</label>
  <input type="{{ type }}" id="cf-{{ name }}" name="{{ name }}"
    {% if required %}required{% endif %}
    {% if maxlength %}maxlength="{{ maxlength }}"{% endif %}
    {% if pattern %}pattern="{{ pattern }}"{% endif %}
    {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
    autocomplete="{{ autocomplete }}">
  {% if hint %}<span class="field__hint">{{ hint }}</span>{% endif %}
</div>
{% endmacro %}

{% macro textarea(name, label, required=false, minlength=0, maxlength=4000, hint="", placeholder="", rows=5) %}
<div class="field">
  <label for="cf-{{ name }}">{{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}</label>
  <textarea id="cf-{{ name }}" name="{{ name }}" rows="{{ rows }}"
    {% if required %}required{% endif %}
    {% if minlength %}minlength="{{ minlength }}"{% endif %}
    {% if maxlength %}maxlength="{{ maxlength }}"{% endif %}
    {% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
    data-counter></textarea>
  <div class="field__row">
    {% if hint %}<span class="field__hint">{{ hint }}</span>{% endif %}
    <span class="field__counter" data-counter-display><span data-counter-current>0</span> / {{ maxlength }}</span>
  </div>
</div>
{% endmacro %}

{% macro select(name, label, options, required=false, hint="") %}
<div class="field">
  <label for="cf-{{ name }}">{{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}</label>
  <select id="cf-{{ name }}" name="{{ name }}" {% if required %}required{% endif %}>
    <option value="">Choose one…</option>
    {% for opt in options %}
    <option value="{{ opt.value }}">{{ opt.label }}</option>
    {% endfor %}
  </select>
  {% if hint %}<span class="field__hint">{{ hint }}</span>{% endif %}
</div>
{% endmacro %}

{% macro checkbox(name, label, required=false, hint="") %}
<div class="field field--check">
  <label class="check-label">
    <input type="checkbox" name="{{ name }}" value="yes" {% if required %}required{% endif %}>
    <span>{{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}</span>
  </label>
  {% if hint %}<span class="field__hint">{{ hint }}</span>{% endif %}
</div>
{% endmacro %}

{% macro rating(name, label, required=false) %}
<div class="field">
  <label class="field__label">{{ label }}{% if required %} <span class="field__req" aria-hidden="true">*</span>{% endif %}</label>
  <div class="rating-input" role="radiogroup" aria-label="{{ label }}">
    {% for n in [5, 4, 3, 2, 1] %}
    <input type="radio" id="cf-{{ name }}-{{ n }}" name="{{ name }}" value="{{ n }}" {% if required and n == 5 %}required{% endif %}>
    <label for="cf-{{ name }}-{{ n }}" aria-label="{{ n }} star{% if n != 1 %}s{% endif %}">★</label>
    {% endfor %}
  </div>
</div>
{% endmacro %}

{% macro submit(label="Send suggestion") %}
<div class="contribute-form__submit">
  <button type="submit" class="btn btn--primary btn--big" data-submit-btn>{{ label }}</button>
  <p class="contribute-form__note">Comes straight to my inbox. No account, no cookies.</p>
</div>
{% endmacro %}

{% macro guidelines(content) %}
<aside class="contribute-page__guidelines">
  <h2>Guidelines</h2>
  {{ content | safe }}
</aside>
{% endmacro %}
