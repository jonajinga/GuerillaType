---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all -%}
{%- if not (item.url | startsWith("/assets/")) and not (item.data.eleventyExcludeFromCollections) and not (item.data.noindex) -%}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ buildDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>{% if item.url == "/" %}1.0{% elif item.url | startsWith("/practice") or item.url | startsWith("/stats") %}0.8{% else %}0.5{% endif %}</priority>
  </url>
{%- endif -%}
{%- endfor -%}
</urlset>
