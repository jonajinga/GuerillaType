  <div class="offline-page__actions" style="display:flex;justify-content:center;gap:.6rem;flex-wrap:wrap;margin-top:var(--space-5)">
    <a class="btn btn--primary" href="/practice/">Practice</a>
    <a class="btn" href="/stats/">Your stats</a>
    <a class="btn" href="/settings/">Settings</a>
    <a class="btn btn--ghost" href="/custom/">Custom texts</a>
  </div>
