---
layout: layouts/base.njk
title: "Suggest a quote"
description: "Suggest a public-domain quote for the GuerillaType library."
permalink: /contribute/quote/
---

{% import "partials/contribute/form-shell.njk" as cf %}

{{ cf.head("Suggest a quote", "A line worth typing again and again. Public-domain only.", "quote") }}

<aside class="contribute-page__guidelines">
  <h2>Guidelines</h2>
  <ul>
    <li>Public-domain only -- generally pre-1929 in the US, or explicitly released under CC0.</li>
    <li>Single attribution -- one author per quote.</li>
    <li>10-1000 characters. Anything longer belongs in <a href="/contribute/poem/">poem</a> or <a href="/contribute/parable/">parable</a>.</li>
    <li>Prefer typeable punctuation -- <em>--</em> not em-dash, ASCII quotes not curly.</li>
  </ul>
</aside>

<form class="contribute-form" method="POST" action="{{ web3forms.endpoint }}" data-contribute-kind="quote">
  {{ cf.hidden("quote", "GT contribution: quote", web3forms) }}

  {{ cf.textarea("quote_text", "The quote", required=true, minlength=10, maxlength=1000, rows=4, hint="Verbatim. Use ASCII punctuation when possible.") }}
  {{ cf.text("quote_author", "Author", required=true, maxlength=120, placeholder="e.g. Mark Twain") }}
  {{ cf.text("quote_year", "Year", maxlength=4, placeholder="e.g. 1884", pattern="[0-9]{1,4}", hint="Approximate is fine.") }}
  {{ cf.text("quote_source", "Source work", maxlength=160, placeholder="e.g. Adventures of Huckleberry Finn", hint="The book, essay, speech, or letter the quote came from.") }}
  {{ cf.text("quote_source_url", "Source URL", maxlength=400, type="url", placeholder="https://www.gutenberg.org/...", hint="Link to a public-domain source if you have one.") }}
  {{ cf.text("quote_tags", "Tags", maxlength=160, placeholder="philosophy, humor, science", hint="Comma-separated. Optional.") }}
  {{ cf.checkbox("public_domain", "I confirm this quote is in the public domain.", required=true) }}
  {{ cf.text("submitter_name", "Your name", maxlength=120, placeholder="Optional", hint="Credited if I publish a contributors list someday. Leave blank to stay anonymous.") }}

  {{ cf.submit("Send quote suggestion") }}
</form>

{{ cf.byline() }}

<script type="module" src="/assets/js/pages/contribute-boot.js?v={{ cssVersion }}"></script>
