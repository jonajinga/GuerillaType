---
layout: layouts/base.njk
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
permalink: "/blog/tag/{{ tag | slugify }}/"
eleventyComputed:
  title: "Posts tagged {{ tag }}"
  description: "GuerillaType blog posts tagged {{ tag }}."
---

<div class="blog-index">
  <header class="blog-index__head">
    <a class="tt-back-link" href="/blog/">← All posts</a>
    <p class="eyebrow">Tag</p>
    <h1>{{ tag }}</h1>
  </header>

  <div class="blog-list">
    {% set posts = collections[tag] | reverse %}
    {% for post in posts %}
    <article class="blog-card">
      <p class="blog-card__date">
        <time datetime="{{ post.data.date | htmlDateString }}">{{ post.data.date | readableDate }}</time>
      </p>
      <h2 class="blog-card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p class="blog-card__deck">{{ post.data.description }}</p>
    </article>
    {% endfor %}
  </div>
</div>
