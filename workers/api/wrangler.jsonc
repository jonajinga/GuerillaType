{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guerillatype-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },

  // Deliberately NO nodejs_compat. Everything here runs on Web Crypto +
  // fetch. Keep it that way -- it keeps cold starts cheap, and cold start
  // is on the critical path for a sign-in redirect.

  "vars": {
    "APP_ORIGIN": "https://guerillatype.com",
    "SESSION_TTL_DAYS": "30"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "guerillatype", "database_id": "TBD", "migrations_dir": "migrations" }
  ],

  "kv_namespaces": [
    // Short-lived OAuth `state` only. NOT user data -- the KV free tier
    // allows just 1k writes/day, which a sync workload would exhaust.
    { "binding": "OAUTH_STATE", "id": "TBD" }
  ],

  // The original this is ported from had no rate limiting anywhere, and
  // /auth/login is unauthenticated AND writes a KV key per call. On a free
  // tier that is the one thing standing between us and a bill.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]

  // Custom domain, enable once DNS is ready:
  // "routes": [{ "pattern": "api.guerillatype.com", "custom_domain": true }]

  // Secrets (never in this file -- `wrangler secret put <NAME>`):
  //   GOOGLE_CLIENT_ID  GOOGLE_CLIENT_SECRET
  //   GITHUB_CLIENT_ID  GITHUB_CLIENT_SECRET
}
