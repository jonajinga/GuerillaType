{
  "name": "guerillatype-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8791",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply guerillatype --local",
    "db:migrate:remote": "wrangler d1 migrations apply guerillatype --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  }
}
